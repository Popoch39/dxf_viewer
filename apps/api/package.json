{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "docker:build": "docker build -f Dockerfile -t dxf-viewer-api ../.."
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.16",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2"
  }
}
