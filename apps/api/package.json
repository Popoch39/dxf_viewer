{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun run --parallel dev:api dev:worker",
    "dev:api": "bun --watch src/index.ts | pino-pretty",
    "dev:worker": "bun --watch src/worker.ts | pino-pretty",
    "start": "bun src/index.ts",
    "start:worker": "bun src/worker.ts",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "docker:build": "docker build -f Dockerfile -t dxf-viewer-api ../.."
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.16",
    "@repo/dxf": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.7.5",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "typescript": "7.0.2"
  }
}
