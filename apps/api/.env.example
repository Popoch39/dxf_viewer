# Copy to `.env` (Bun loads it automatically). Values match `compose.yaml`.
PORT=3000

# fatal, error, warn, info, debug, trace or silent. Defaults to info.
LOG_LEVEL=info

DATABASE_URL=postgres://dxf:dxf@localhost:5442/dxf

REDIS_URL=redis://localhost:6389

# Largest accepted Fichier source, in bytes. Defaults to 200 MiB.
MAX_UPLOAD_BYTES=209715200

# Parsings run at once by each worker process. Defaults to 2.
PARSING_CONCURRENCY=2

# Signs session cookies. In production, generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production
# Public URL of the API, also an origin trusted for cookie-authenticated requests.
BETTER_AUTH_URL=http://localhost:3000
# Origin of the viewer: the only one allowed by CORS, also trusted by Better Auth.
VIEWER_URL=http://localhost:5173

S3_ENDPOINT=http://localhost:9010
S3_BUCKET=dxf
S3_ACCESS_KEY_ID=dxf
S3_SECRET_ACCESS_KEY=dxf-secret
S3_REGION=us-east-1
