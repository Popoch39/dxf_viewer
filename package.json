{
  "name": "dxf_viewer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
